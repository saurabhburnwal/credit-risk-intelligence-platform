# ==============================================================================
# AI-Powered Credit Risk Intelligence Platform - Environment Configuration
# ==============================================================================

# LLM Providers
# Tier 1: Groq Cloud API (Optional - If omitted or failing, system cascades to Tier 2)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tier 2: Local Ollama (Used automatically when GROQ_API_KEY is unset or unreachable)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ministral-3:3b

# Extension Provider Stubs (Not active, documented for architecture extensibility)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# Application Configuration
FLASK_PORT=5000
FLASK_DEBUG=0
SECRET_KEY=neostats-credit-risk-intelligence-key-2026

# Paths (Leave empty to auto-detect ./data or ../home-credit-default-risk)
DATA_DIR=
MODEL_PATH=models/lightgbm_credit_model.joblib
DB_PATH=sql/credit_risk.db
