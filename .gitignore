# Python & Virtual Environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# uv Cache
.uv/
.uv_cache/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
tests/screenshots/

# Datasets - Strict exclusion per NeoStats specification ("Don't place dataset in git")
data/*
!data/.gitkeep
*.csv
*.parquet
*.feather
*.zip
*.tar.gz

# SQLite Database (strictly ignored - dynamically built on first run from data/ CSVs)
sql/*.db
sql/*.db.gz
*.db
*.db.gz
!sql/schema.sql
!sql/.gitkeep

# Large Model / Temp Artifacts (LightGBM 1.3MB and Preprocessor 11KB are tracked for zero-setup evaluation)
*.pkl
models/*.pkl

# Environment Variables
.env
.env.local

# OS & IDE Files
.DS_Store
.vscode/
.idea/

# Agent / Task Scaffolding
.agents/
ORIGINAL_REQUEST.md
