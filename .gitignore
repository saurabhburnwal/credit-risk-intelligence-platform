# Python & Virtual Environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# uv Cache
.uv/
.uv_cache/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Datasets - Strict exclusion per NeoStats specification ("Don't place dataset in git")
data/*
!data/.gitkeep
*.csv
*.parquet
*.feather
*.zip
*.tar.gz

# SQLite Database (uncompressed db is ignored; 37MB gzipped archive is tracked for evaluator zero-setup)
sql/*.db
*.db
!sql/credit_risk.db.gz
!sql/schema.sql

# Large Model / Temp Artifacts (LightGBM 1.3MB and Preprocessor 11KB are tracked for zero-setup evaluation)
*.pkl
models/*.pkl

# Environment Variables
.env
.env.local

# OS & IDE Files
.DS_Store
.vscode/
.idea/
